# Provedor de IA: "local" (default, sem chaves) ou "http" (API externa compatível)
AI_PROVIDER=local
# Usado apenas quando AI_PROVIDER=http
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Fotografia real (https://www.pexels.com/api — grátis). Sem chave, o agente
# usa o catálogo curado; o LoremFlickr foi removido.
PEXELS_API_KEY=
